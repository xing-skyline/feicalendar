{
  "name": "feicalendar",
  "productName": "FeiCalendar",
  "version": "0.4.0",
  "description": "飞历 — 连接飞书的桌面日历",
  "author": "xing-skyline",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win portable --x64",
    "test:desktop": "node scripts/smoke.mjs",
    "test:portable": "node scripts/portable-smoke.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/list": "6.1.22",
    "@fullcalendar/luxon3": "6.1.22",
    "@fullcalendar/multimonth": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "date-fns": "^4.1.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.468.0",
    "luxon": "3.7.2",
    "node-ical": "0.27.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rrule": "^2.8.1",
    "tsdav": "^2.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@larksuite/cli": "^1.0.99",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.9.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.0"
  },
  "build": {
    "appId": "cn.xingskyline.feicalendar",
    "compression": "normal",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@larksuite/cli",
        "to": "lark-cli",
        "filter": [
          "bin/**/*",
          "scripts/**/*",
          "package.json",
          "LICENSE"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "artifactName": "FeiCalendar-${version}-win-x64.exe",
      "icon": "build/icon.ico",
      "signExecutable": false
    }
  },
  "overrides": {
    "minimatch@>=7 <11": "^11.0.5"
  }
}
